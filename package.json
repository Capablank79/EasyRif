    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
