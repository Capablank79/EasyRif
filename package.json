    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
