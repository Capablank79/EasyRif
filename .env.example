# En producción debe ser una URL https pública (se rechaza localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL independiente. Solo servidor: nunca exponer al navegador.
# Copie este archivo a .env.local (ignorado por Git) y escriba sus contraseñas allí.
# Rol de aplicación (privilegios mínimos): lo usa la app en ejecución.
DATABASE_URL=postgres://easyrif_app:CAMBIAR@localhost:5433/easyrif_dev
# Rol de migraciones (DDL): solo para `npm run db:migrate`.
DATABASE_URL_MIGRATOR=postgres://easyrif_migrator:CAMBIAR@localhost:5433/easyrif_dev

# Autenticacion (Better Auth). Genere el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES
BETTER_AUTH_URL=http://localhost:3000

# Maximo de numeros por rifa (opcional; por defecto 10000, tope 100000)
# RAFFLE_MAX_NUMBERS=10000
# RAFFLE_MAX_BOOKLETS=500
# RAFFLE_MAX_NUMBERS_PER_BOOKLET=200

# BUILD-008 V0.8.1: zona horaria IANA para fechas de cierre y sorteo
# APP_TIMEZONE=America/Santiago

# BUILD-006
RESERVATION_TTL_MINUTES=10
RESERVATION_MAX_SELECTION=10
STORAGE_LOCAL_DIR=.storage
